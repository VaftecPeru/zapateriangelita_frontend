<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Archivos y carpetas reales se sirven normalmente.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Todas las rutas del frontend vuelven al punto de entrada de React.
    RewriteRule ^ index.html [L]
</IfModule>
